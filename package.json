{
  "name": "recoveryos",
  "private": true,
  "version": "0.1.0",
  "description": "RecoveryOS — the Grace For Addictions digital recovery-support ecosystem",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @recoveryos/platform dev",
    "generate:residence-docs": "tsx scripts/generate-residence-docs.ts",
    "build": "pnpm -r --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\""
  },
  "devDependencies": {
    "@recoveryos/residence-content": "workspace:*",
    "prettier": "^3.5.0",
    "sharp": "^0.35.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
