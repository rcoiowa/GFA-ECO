{
  // Staging deployment for the RecoveryOS platform (same static-assets Worker
  // pattern the legacy builds use). Deploy: pnpm build && npx wrangler deploy
  // (requires CLOUDFLARE_API_TOKEN with Workers Scripts:Edit).
  // Phase 9 cutover re-points the vrcc.app custom domain to this Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recoveryos-staging",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
