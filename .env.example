# RecoveryOS environment template
# Copy to apps/<app>/.env.local for local development. Never commit real values.

# Supabase (project ref: ykykeioydvtxpyreshhs)
VITE_SUPABASE_URL=https://ykykeioydvtxpyreshhs.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-publishable-anon-key

# Experience identity (set per app; used for service-event delivery context)
VITE_RECOVERYOS_EXPERIENCE=vrcc

# Optional: Cloudflare Worker API gateway
VITE_API_BASE_URL=https://api.vrcc.app
