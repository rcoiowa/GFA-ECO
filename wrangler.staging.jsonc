{
  // NON-PRODUCTION staging Worker for P4H verification (P4H-G1 §4).
  // Deploys the same static-assets pattern as the root wrangler.jsonc but to
  // the pre-existing `recoveryos-staging` Worker, so staging can never
  // clobber the production-candidate Worker (`gfa-eco-recovery-residence-os`)
  // or vrcc.app. Deploy: `pnpm build && npx wrangler@4 deploy --config wrangler.staging.jsonc`.
  "$schema": "https://esm.sh/wrangler/config-schema.json",
  "name": "recoveryos-staging",
  "main": "workers/platform/index.mjs",
  "vars": { "WEATHER_ENABLED": "true" },
  "compatibility_date": "2026-07-01",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./apps/platform/dist",
    "not_found_handling": "single-page-application",
  },
}
